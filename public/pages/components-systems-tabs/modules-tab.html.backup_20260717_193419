<div id="tab-modules" class="tab-content">
  <div style="margin-bottom:10px;">
    <button id="addModuleBtn" class="btn btn-primary" style="display:none;">Добавить модуль системы</button>
    <button id="exportModulesBtn" class="btn btn-secondary" style="display:none;">Экспорт выгрузка</button>
    <input type="file" id="importModulesFile" style="display:none" accept=".xlsx,.xls">
    <button id="importModulesBtn" class="btn btn-secondary" style="display:none;">Импорт выгрузка</button>
  </div>
  <div class="table-container">
    <table class="data-table">
      <thead><tr><th>ID</th><th>Название</th><th>Описание</th>
              <th id="modulesActionsCol" style="display:none;">Действия</th></tr></thead>
      <tbody id="modulesBody"><tr><td colspan="4" class="loading">Загрузка...</td></tr></tbody>
    </table>
  </div>
  <div id="modulesEmpty" class="empty-state" style="display:none;"><p>Модулей нет</p></div>
</div>
<script>
(function() {
 var currentUser=JSON.parse(localStorage.getItem('user') || 'null');
 var isAdmin=currentUser && currentUser.role==='admin';
 function applyPermissions(){
  var btns=['addModuleBtn','exportModulesBtn','importModulesBtn'];
  btns.forEach(function(id){ var el=document.getElementById(id); if(el) el.style.display=isAdmin?'':'none'; });
  var col=document.getElementById('modulesActionsCol');
  if(col) col.style.display=isAdmin?'':'none';
 }
 function esc(s){ var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
 function loadModules(){
  var tbody=document.getElementById('modulesBody');
  if(!tbody) return;
  fetch('/api/system-modules?_='+Date.now()).then(function(r){ if(!r.ok) throw new Error('Ошибка'); return r.json(); })
  .then(function(data){
   var empty=document.getElementById('modulesEmpty');
   if(!data.length){
    if(empty) empty.style.display='';
    tbody.innerHTML='';
   }else{
    if(empty) empty.style.display='none';
    var html='';
    data.forEach(function(item){
     html+='<tr><td>'+item.id+'</td><td>'+esc(item.name)+'</td><td>'+esc(item.description || '')+'</td>';
     if(isAdmin){
      html+='<td><button class="btn btn-sm btn-edit" onclick="editSystemModule('+item.id+')">✏️</button> <button class="btn btn-sm btn-delete" onclick="deleteSystemModule('+item.id+')">🗑️</button></td>';
     }
     html+='</tr>';
    });
    tbody.innerHTML=html;
   }
  }).catch(function(err){
   console.error(err);
   tbody.innerHTML='<tr><td colspan="4" class="error">Ошибка загрузки</td></tr>';
  });
 }

 // ====== ИЗОЛИРОВАННОЕ МОДАЛЬНОЕ ОКНО МОДУЛЯ ======
 function openModuleModal(id, callback) {
   var isEdit = !!id;
   var m = document.createElement('div');
   m.className = 'modal';
   m.style.cssText = 'display:flex; justify-content:center; align-items:center; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:5000;';
   m.innerHTML = '<div class="modal-content" style="max-width:500px;max-height:90vh;overflow-y:auto;">' +
     '<span class="modal-close">&times;</span>' +
     '<h3>'+(isEdit?'Редактировать модуль':'Добавить модуль системы')+'</h3>' +
     '<form id="moduleForm">' +
       '<div class="form-group"><label>Название: <span style="color:red;">*</span></label><input type="text" id="moduleName" required></div>' +
       '<div class="form-group"><label>Описание:</label><textarea id="moduleDescription" rows="3"></textarea></div>' +
       '<div class="form-actions">' +
         '<button type="submit" class="btn btn-primary">Сохранить</button>' +
         '<button type="button" class="btn btn-secondary cancel-module-btn">Отмена</button>' +
       '</div>' +
     '</form>' +
   '</div>';
   document.body.appendChild(m);

   function closeModal() { m.remove(); }
   m.querySelector('.modal-close').addEventListener('click', closeModal);
   m.querySelector('.cancel-module-btn').addEventListener('click', closeModal);
   m.addEventListener('click', function(e) { if(e.target === m) closeModal(); });

   var form = m.querySelector('#moduleForm');
   if (isEdit) {
     fetch('/api/system-modules/'+id).then(function(r){ return r.json(); }).then(function(item){
       form.moduleName.value = item.name;
       form.moduleDescription.value = item.description || '';
     }).catch(function(e){ alert('Ошибка загрузки данных'); closeModal(); });
   }

   form.addEventListener('submit', function(e){
     e.preventDefault();
     var name = form.moduleName.value.trim();
     if (!name) { alert('Введите название'); return; }
     var body = {
       name: name,
       description: form.moduleDescription.value.trim()
     };
     var url = isEdit ? '/api/system-modules/'+id : '/api/system-modules';
     var method = isEdit ? 'PUT' : 'POST';
     fetch(url, {
       method: method,
       headers: { 'Content-Type': 'application/json' },
       body: JSON.stringify(body)
     }).then(function(r){ if(!r.ok) return r.json().then(function(d){ throw new Error(d.message); }); })
     .then(function(){
       closeModal();
       loadModules();
       if (callback) callback();
     }).catch(function(e){ alert(e.message); });
   });
 }

 document.getElementById('addModuleBtn').addEventListener('click', function(){
   openModuleModal(null);
 });

 window.editSystemModule = function(id){
   openModuleModal(id);
 };

 window.deleteSystemModule = function(id){
  if(!confirm('Удалить модуль?')) return;
  fetch('/api/system-modules/'+id, { method:'DELETE' })
  .then(loadModules)
  .catch(function(e){ alert(e.message); });
 };

 document.getElementById('exportModulesBtn').addEventListener('click', async function(){
  var r=await fetch('/api/system-modules/export');
  var b=await r.blob();
  var a=document.createElement('a');
  a.href=URL.createObjectURL(b);
  a.download='system_modules.xlsx';
  a.click();
 });

 document.getElementById('importModulesBtn').addEventListener('click', function(){
  document.getElementById('importModulesFile').click();
 });

 document.getElementById('importModulesFile').addEventListener('change', async function(){
  var fd=new FormData();
  fd.append('file', this.files[0]);
  await fetch('/api/system-modules/import', { method:'POST', body:fd });
  loadModules();
  this.value='';
 });

 applyPermissions();
 loadModules();
})();
</script>